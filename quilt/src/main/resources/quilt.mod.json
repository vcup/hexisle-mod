{
  "schema_version": 1,
  "quilt_loader": {
    "group": "moe.vcup",
    "id": "hexisle",
    "version": "${version}",
    "metadata": {
      "name": "hexisle",
      "description": "A Hex Casting addon for Minecraft 1.20.1.",
      "contributors": {
        "vcup": "Owner"
      },
      "license": "MIT"
    },
    "intermediate_mappings": "net.fabricmc:intermediary",
    "entrypoints": {
      "init": [
        "moe.vcup.hexisle.quilt.HexisleQuilt"
      ]
    },
    "depends": [
      {
        "id": "quilt_loader",
        "versions": ">=0.19.2"
      },
      {
        "id": "quilted_fabric_api",
        "versions": ">=7.0.0"
      },
      {
        "id": "minecraft",
        "versions": "~1.20.1"
      },
      {
        "id": "hexcasting",
        "versions": ">=0.11.0"
      }
    ]
  },
  "mixin": [
    "hexisle.mixins.json",
    "hexisle.quilt.mixins.json"
  ]
}
